# ==========================================================
# PojokBola - Contoh environment variables
# Salin file ini menjadi ".env.local" untuk pengembangan lokal.
# JANGAN commit file .env.local ke GitHub.
# ==========================================================

# --- Situs ---
NEXT_PUBLIC_SITE_URL=https://pojokbola.web.id
NEXT_PUBLIC_SITE_NAME=PojokBola

# --- API sepak bola (server-side only, tanpa prefix NEXT_PUBLIC_) ---
# Provider aktif: football-data (https://www.football-data.org)
# Daftar token gratis di situs provider. Nilai di bawah adalah PLACEHOLDER, bukan kunci asli.
FOOTBALL_PROVIDER=football-data
FOOTBALL_DATA_API_KEY=ISI_TOKEN_ANDA_DI_SINI

# --- Google Search Console & AdSense (isi setelah tersedia) ---
# Kode verifikasi GSC (meta tag). Kosongkan jika belum ada.
NEXT_PUBLIC_GSC_VERIFICATION=
# Publisher ID AdSense, format ca-pub-XXXXXXXXXXXXXXXX. Kosongkan sampai akun disetujui.
# Publisher ID dipindahkan ke lib/config.ts (ADSENSE.publisherId); tidak perlu env.

